# Two-VM lab: "sensor" runs netids, "attacker" runs nmap.
# Usage: vagrant up   then   vagrant ssh attacker -c "sudo /vagrant/scripts/simulate_attack.sh 192.168.56.10"
Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"

  config.vm.define "sensor" do |s|
    s.vm.hostname = "sensor"
    s.vm.network "private_network", ip: "192.168.56.10"
    s.vm.provision "shell", inline: <<-SHELL
      bash /vagrant/scripts/install.sh
      sed -i 's/interface = "eth0"/interface = "eth1"/' /etc/netids/config.toml
      systemctl restart netids || true
    SHELL
  end

  config.vm.define "attacker" do |a|
    a.vm.hostname = "attacker"
    a.vm.network "private_network", ip: "192.168.56.20"
    a.vm.provision "shell", inline: "apt-get update -qq && apt-get install -y -qq nmap"
  end
end
